# Custom secrets or credentials
secrets.env
credentials.json

# Pipeline outputs (large files)
data/*
# Two small, derived, PUBLIC files under data/ottilie/ are tracked: the clone-name dictionary
# (paper tables <-> SRA, with manual overrides that are not cheaply reproducible) and the pilot
# truth set extracted from the paper's supplements. Both ship in the public release bundle.
!data/ottilie/
data/ottilie/*
!data/ottilie/sample_name_dictionary.csv
!data/ottilie/pilot_truth_set.csv
# Track dicarboxylic acids mutation analysis (scripts + raw literature files)
!data/dicarboxylic_acids/
!data/dicarboxylic_acids/**
data/dicarboxylic_acids/downstream_format_mutations/
*/output/*
output/*
*/out/
output_all/*
output_NCYC495/
output_quick_test_NCYC495/
test_output/
output_test_001/
work_CENPK/
work_NCYC495/
work_CENPK_subset/
# Archived investigation artifacts (kept locally, not committed)
docs/archive/investigate_filter/

# Output and work directories at any level
**/output_*/
**/work_*/
# Regenerated class dumps of the Nextflow 26.x coverage probe (run_probe.sh); out/ale_lint.txt is committed
docs/dev-practices/nextflow_branch_counting/nf26/out/*/

# Quality control - ignore data, output, and comparison folders
quality_control/*/data/
quality_control/*/output/
quality_control/*/comparison/

# Keep QC scripts, READMEs, and result summaries
!quality_control/**/*.py
!quality_control/**/*.R
!quality_control/**/*.sh
!quality_control/**/README.md

# BUSCO output and downloaded lineage databases
assets/references/busco_output/
assets/references/busco_downloads/

# IGV reports - generated outputs (large HTML with embedded CRAM/VCF data)
docs/igvreports/**/samples/
docs/igvreports/**/multiqc_report.html
docs/igvreports/**/mutation_overview.html
docs/igvreports/**/prepare/
docs/igvreports/**/pipeline_info/
docs/igvreports/**/*.png

# macOS .DS_Store in tracked subdirectories (overrides !data/dicarboxylic_acids/**)
data/dicarboxylic_acids/.DS_Store
.env

# v2 report output (generated, not tracked)
docs/igvreports/ottilie_4samples_v2/

# Nextflow pipeline_info when outdir is unset (resolves to literal "null")
null/

# nf-test working directory
.nf-test/

# Local git worktrees for diffing against pristine sarek 3.5.1 (see docs/dev-practices/
# SAREK_MODIFICATIONS.md). ~1.9 GB of full checkouts — local aids, never committed.
# NOTE: scope to worktrees/ only — .claude/skills/ IS tracked.
.claude/worktrees/

# Ottilie blob staging: snpeff cache untarred by bin/test_ottilie_blob.sh until 2026-11, and the
# publish_test_data.sh scratch dir (both transient, both re-fetchable from the blob)
.ottilie_ci_cache/
.ottilie_publish/
docs/igvreports/ottilie_4samples/
docs/igvreports/demo/

# Per-sample audit intermediates (manta_joint_vs_single.py). summary.tsv and REPORT.md are the
# committed record; these are regenerated from them by run_manta_joint_at_scale.sh. Verified
# byte-identical on regeneration 2026-09-07 -- see that script's header for the inputs required.
docs/benchmarking/**/details_*.tsv
