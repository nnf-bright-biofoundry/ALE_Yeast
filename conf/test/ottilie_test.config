/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running Ottilie yeast ALE test dataset
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Minimal test with 2 samples (parent + evolved) on 4 chromosomes (I, IV, VII, XV).
    Truth variants: 4 SNVs + 1 whole-chromosome duplication (chr I) in CBR110-15-R3a.
    Source: Ottilie et al., Commun Biol 5:128 (2022), SRR10985539 + SRR10985585.

    Usage: `nextflow run main.nf -profile ottilie_test,azureD4as,docker`

    Data: Test FASTQs (~360 MB) and reference (~35 MB) live under data/ottilie/ and are
    gitignored. Generate locally with:
      bash docs/benchmarking/ottilie_xenobiotic_ale/01_data_retrieval/release/generate_test_data.sh
    For a fresh machine, fetch data + samplesheet with download_test_data.sh (public blob, no creds).
    To run the same test with NO local data at all, use the `ottilie_test_ci` profile
    (conf/test/ottilie_test_ci.config, launcher bin/test_ottilie_blob.sh) — it streams the blob-URL
    samplesheet (samplesheet_test_blob.csv) and every reference file. Do NOT rewrite this local
    samplesheet to URLs.
    See docs/benchmarking/ottilie_xenobiotic_ale/DATA_PROVENANCE.md; provisioning in infra/azure/.
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

// Callers and joint-germline settings are shared with every other ottilie profile.
includeConfig 'ottilie_common.config'

params {
    config_profile_name        = 'Ottilie Test Profile'
    config_profile_description = 'Minimal yeast ALE test — 2 samples, 4 chromosomes, all variant callers'

    // Input
    input                      = "${projectDir}/data/ottilie/samplesheet_test.csv"

    // Reference: ONE GenBank, the 4-chromosome subset of S288C R64 (LOCUS I, IV, VII, XV). The run
    // derives the FASTA, the snpEff database (named S288C_R64_test after the file) and the report's
    // gene track from it and publishes them under <outdir>/reference/S288C_R64_test/.
    // The pre-built files of the same genome are still in data/ottilie/ (S288C_R64_test.fa,
    // snpeff_cache/R64-1-1.105, S288C_reference/S288C_R64.gff3): tests/qc_gate_prebuilt_params.yml
    // runs the test set on them.
    genbank                    = "${projectDir}/data/ottilie/S288C_reference_test/S288C_R64_test.gb"

    // Mutation report — generate_reports defaults true (nextflow.config); the nf-test enables it
    // via its own `when` block. The report-machinery params (filter_config, templates, index_script,
    // templates_dir) use their ${projectDir}/docs/igvreports defaults — not set here.
}
