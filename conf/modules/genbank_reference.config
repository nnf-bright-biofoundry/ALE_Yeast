/*
 * Reference from one GenBank file (docs/dev-practices/genbank_reference_input.md §5): the extract task
 * and the snpEff build, both before alignment. Each writes rows of the "yAMP input checks" table and
 * exits 65 on a failed check, like PREFLIGHT_REFERENCE (conf/modules/preflight.config), so the same
 * rules apply: stop the run at once, forward the verdict lines, publish the table.
 */

process {
    withName: 'GENBANK_REFERENCE' {
        errorStrategy = 'terminate'   // exit 65 is outside the base retry range; stop before any other task
        debug         = true          // the [yAMP preflight] WARN/ERROR lines; nothing on a clean file
        publishDir    = [
            [
                path: { "${params.outdir}/reports/preflight" },
                mode: params.publish_dir_mode,
                pattern: '*_mqc.tsv'
            ],
            [
                // the run's reference record (the GenBank itself, FASTA, GFF3, manifest), always
                // published, not only with save_reference
                path: { "${params.outdir}/reference/${db}" },
                mode: params.publish_dir_mode,
                pattern: '{*.fa,*.gff3,contig_manifest.csv,*.gb,*.gbk,*.gbff,*.genbank,*.gb.gz,*.gbk.gz,*.gbff.gz,*.genbank.gz}'
            ]
        ]
    }
    withName: 'SNPEFF_BUILD' {
        errorStrategy = 'terminate'
        debug         = true
        publishDir    = [
            [
                path: { "${params.outdir}/reports/preflight" },
                mode: params.publish_dir_mode,
                pattern: '*_mqc.tsv'
            ],
            [
                path: { "${params.outdir}/reference/${meta.id}" },
                mode: params.publish_dir_mode,
                pattern: '{snpeff_cache,*.snpeff_build.log}'
            ]
        ]
    }
}
