/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Resources for LOCAL nf-test runs of the ottilie profile
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Loaded by tests/nf-test-ottilie.config as its `configFile`. Sets NO params, so it does
    not clobber the ottilie_test profile's input/tools (which a params-bearing -c config
    would, see the config-precedence note in the docs below). Three parts, for the dev VM
    (4 vCPU / 16 GB):

      resourceLimits   the clamp: no single task may request more than the machine has.
      executor.cpus    the local scheduler's CPU budget, set ABOVE the clamp on purpose.
      memory requests  trimmed to measured peaks, so no task needs most of the memory budget.

    Why the last two. The local scheduler starts a task only when its request fits what
    its own counters say is free. A task that requests the WHOLE budget can therefore start
    only when the counters read exactly "all free", and they do not always return there:
    on 2026-11-09 a contract-test run never reserved more than 3 of its 4 CPUs after two
    tasks finished and two started within the same 10 ms, and the last four SNPEFF_SNPEFF
    tasks (4 CPUs each) stayed queued for good with nothing running. With a CPU budget of 8
    and a per-task cap of 4, and with no memory request above about half of the memory
    budget, one lost unit no longer strands a task. Neither setting changes what a task is
    given: `task.cpus` (the thread count the tools receive) is untouched, and the memory
    values are the ones conf/azured4as.config has used for every launcher run.
    See docs/dev-practices/compute_resources.md § "nf-test resources" and
    docs/usage/nextflow_local_executor_deadlock.md.
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

// A budget, not a hardware count: twice the per-task cap, so a task that asks for the cap
// never needs every CPU the scheduler believes it has. Memory keeps Nextflow's default
// budget (the machine's physical memory), which is what bounds real concurrency.
executor {
    cpus = 8
}

process {
    resourceLimits = [
        cpus: 4,
        memory: '14.GB',
        time: '24.h'
    ]

    // Measured on the test set, contract-test run of 2026-11-09 (peak RSS): HaplotypeCaller
    // 1.4 GB, snpEff 1.0 GB, MultiQC 1.0 GB, CNVKit batch 0.6 GB, BWA-MEM 2.0 GB,
    // MarkDuplicates 7.5 GB at a 14 GB request. `* task.attempt` keeps base.config's
    // escalation on a retry; the clamp above still applies.
    withLabel: 'process_single' {
        memory = { 4.GB * task.attempt }
    }
    withLabel: 'process_low' {
        memory = { 4.GB * task.attempt }
    }
    withLabel: 'process_medium' {
        memory = { 4.GB * task.attempt }
    }
    withLabel: 'process_high' {
        memory = { 6.GB * task.attempt }
    }
    // base.config sets these by name, and a name selector outranks a label selector.
    withName: 'GATK4_MARKDUPLICATES' {
        memory = { 8.GB * task.attempt }
    }
    withName: 'BWAMEM1_MEM' {
        memory = { 6.GB * task.attempt }
    }
    withName: 'CNVKIT_BATCH' {
        memory = { 4.GB * task.attempt }
    }
    withName: 'MULTIQC' {
        memory = { 4.GB * task.attempt }
    }
    withName: 'GATK4_CREATESEQUENCEDICTIONARY' {
        memory = { 4.GB * task.attempt }
    }
}
