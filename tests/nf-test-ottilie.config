/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Dedicated nf-test config for the ALE (ottilie) test suite
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Usage (from repo root):
        nf-test test -c tests/nf-test-ottilie.config tests/ottilie_e2e.nf.test

    Why a SEPARATE nf-test config (not the default nf-test.config):
      - The default nf-test.config force-loads `configFile "conf/test.config"` (upstream sarek
        test data: input/genome/tools=strelka) as a -c config. A -c config OUTRANKS profiles, so
        it would clobber the ottilie_test profile's input/tools (verified 2026-07-13). Here we point
        configFile at a params-free resources config (clamp, scheduler CPU budget, trimmed
        memory requests; nothing else) → no clobbering.
      - profile "ottilie_test,docker" activates the ALE test dataset + container engine. No azureD4as
        needed (resourceLimits come from ottilie_nftest_resources.config).
    The default nf-test.config is left 0-diff vs upstream sarek 3.5.1 on purpose (upgrade-friendliness:
    it returns unchanged on a future re-fork/migration). The inapplicable upstream pipeline tests it
    used to serve were triaged out (see docs/dev-practices/testing_best_practices.md §10); the ALE
    suite (ottilie_e2e + split_joint_vcf) always runs via this `-c` config, never the root default.
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

config {
    // Scope discovery to tests/ (avoids the modules/nf-core + .claude/worktrees test pollution)
    testsDir "tests"

    workDir System.getenv("NFT_WORKDIR") ?: ".nf-test"

    // resources only (no params) — does not clobber the ottilie_test profile
    configFile "tests/ottilie_nftest_resources.config"

    // ALE test dataset + docker; resourceLimits from the configFile above
    profile "ottilie_test,docker"

    // Change-detection deps (only consulted by `nf-test test --changed-since`/`--related-tests`; inert
    // for a plain `nf-test test`). Lists THIS suite's global inputs so a change to any of them re-runs
    // the ottilie tests instead of reporting a stale cached pass. Mirrors the root nf-test.config's
    // `triggers`, but with OUR files (the ottilie profile + its resource/nftignore configs).
    triggers 'nextflow.config', 'conf/test/ottilie_test.config', 'conf/test/ottilie_common.config', 'tests/.nftignore',
             'tests/nf-test-ottilie.config', 'tests/ottilie_nftest_resources.config',
             'conf/modules/trimming.config', 'assets/multiqc_config.yml'

    plugins {
        load "nft-bam@0.4.0"
        load "nft-utils@0.0.3"
        // nft-vcf: path(x).vcf.variantsMD5 — hashes variant records, ignoring the non-deterministic
        // header (GATK timestamp). Same convention as nft-bam's cram().readsMD5 for CRAMs. Used by the
        // ottilie e2e test to gate the joint/cohort HaplotypeCaller VCF content.
        load "nft-vcf@1.0.7"
    }
}
